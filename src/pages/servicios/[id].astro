---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import servicios from '../../data/servicios.json';
const images = import.meta.glob('/public/img/*.{jpeg,jpg,png,gif}');

const imagenesPublicas: string[] = readdirSync(join(process.cwd(), 'public', 'img'));
const imagenesPorNombre = new Map(
  imagenesPublicas.map((nombre) => [nombre.toLowerCase(), nombre]),
);

function resolverImagen(ruta: string | undefined) {
  if (!ruta) return undefined;

  const nombre = ruta.split('/').pop();
  if (!nombre) return ruta;

  const coincidenciaExacta = imagenesPorNombre.get(nombre.toLowerCase());
  if (coincidenciaExacta) return `/img/${coincidenciaExacta}`;

  const nombreBase = nombre.replace(/\.[^.]+$/, '').toLowerCase();
  const coincidenciaPorBase = imagenesPublicas.find((archivo) =>
    archivo.replace(/\.[^.]+$/, '').toLowerCase() === nombreBase,
  );

  return coincidenciaPorBase ? `/img/${coincidenciaPorBase}` : ruta;
}

export async function getStaticPaths() {
  return servicios.map((servicio) => ({
    params: { id: servicio.id },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
---

<Layout title={`${servicio.titulo} a medida | Tapicería San Pedro`}>
  <main class="max-w-7xl mx-auto px-6 py-20">
    
    <a href="/#servicios" class="text-carbon-claro hover:text-carbon text-sm font-medium mb-12 inline-block transition-colors">
      &larr; Volver al catálogo
    </a>

    <!-- Cabecera principal del servicio -->
    <div class="text-center mb-20">
      <div class={`service-title service-title--${servicio.id}`}>
        <h1 class="text-4xl md:text-6xl font-bold text-carbon mb-6">{servicio.titulo}</h1>
        <div class="text-lg text-carbon-claro max-w-3xl mx-auto space-y-4">
          {Array.isArray(servicio.descripcion) ? (
            servicio.descripcion.map((parrafo) => <p>{parrafo}</p>)
          ) : (
            <p>{servicio.descripcion}</p>
          )}
        </div>
      </div>
    </div>

    <!-- SECCIÓN INTERCALADA: Tipos / Variantes -->
    {(servicio.tipos || []).length > 0 ? (
      <div class="flex flex-col gap-24 mb-24">
        {servicio.tipos.map((tipo, index) => (
          <div class={`flex flex-col md:flex-row gap-10 md:gap-16 items-center ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`}>
            <div class="w-full md:w-1/2 flex flex-col justify-center">
              <h2 class="text-3xl font-bold text-carbon mb-4">{tipo.nombre}</h2>
              <p class="text-lg text-carbon-claro leading-relaxed">{tipo.descripcion}</p>
            </div>

            <div class="w-full md:w-1/2">
              <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 scrollbar-hide">
                {(tipo.galeria || []).length > 0 ? (
                  tipo.galeria.map((foto) => (
                    <div class="snap-center shrink-0 w-full aspect-[4/3] bg-[#D4D4D0] rounded-3xl overflow-hidden shadow-sm">
                      <img
                        src={resolverImagen(foto)}
                        alt={tipo.nombre}
                        class="w-full h-full object-cover"
                        onerror="this.onerror=null;this.src='/img/taller-generico.svg';"
                      />
                    </div>
                  ))
                ) : (
                  <div class="snap-center shrink-0 w-full aspect-[4/3] bg-[#EFEFEA] border border-[#D4D4D0] rounded-3xl flex items-center justify-center text-carbon-claro text-sm">
                    Sin imágenes disponibles
                  </div>
                )}
              </div>

              {(tipo.galeria || []).length > 1 && (
                <p class="text-center text-xs text-carbon-claro mt-2">Desliza para ver más fotos &rarr;</p>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="mb-24 w-full max-w-4xl mx-auto aspect-video bg-[#D4D4D0] rounded-3xl overflow-hidden shadow-sm">
        <img
          src={resolverImagen(servicio.imagen)}
          alt={servicio.titulo}
          class="w-full h-full object-cover"
          onerror="this.onerror=null;this.src='/img/taller-generico.svg';"
        />
      </div>
    )}

    <!-- Caja de Presupuesto Final -->
    <div class="contacto-panel border rounded-3xl p-10 md:p-16 text-center max-w-4xl mx-auto">
      <h3 class="text-2xl md:text-3xl font-bold text-carbon mb-4">¿Necesitas presupuesto para tu hogar?</h3>
      <p class="text-carbon-claro text-lg mb-8 max-w-xl mx-auto">
        Hacemos un presupuesto aproximado sin compromiso. Cuéntanos qué idea tienes y te asesoraremos con los mejores materiales.
      </p>
      <a href="https://wa.me/34600000000" class="contacto-boton inline-block px-10 py-4 text-lg rounded-xl border-2" target="_blank" rel="noopener noreferrer">
        Consultar por WhatsApp
      </a>
    </div>

  </main>
</Layout>