---
import Layout from '../layouts/Layout.astro';
// 1. Importamos el archivo JSON como si fuera código
import servicios from '../data/servicios.json';
---

<Layout title="Tapicería San Pedro | Artesanía y Confección a Medida">
  
  <!-- SECCIÓN HERO -->
  <section class="max-w-7xl mx-auto px-6 py-20 md:py-32 flex flex-col items-center text-center">
    
    <div class="inline-block border border-[#D4D4D0] rounded-full px-4 py-1.5 mb-6 bg-[#EFEFEA]">
      <span class="text-sm font-medium text-carbon-claro">📍 San Pedro Alcántara</span>
    </div>

    <h1 class="text-5xl md:text-7xl font-bold text-carbon tracking-tight leading-tight max-w-4xl">
      Artesanía en tapicería y <br class="hidden md:block" /> cortinas a medida
    </h1>

    <p class="mt-6 text-lg md:text-xl text-carbon-claro max-w-2xl">
      Renueva tus espacios con trabajos profesionales de alta calidad. Diseño, confección e instalación de toldos, cabeceros, estores y cortinas.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
      <a href="https://wa.me/34600000000" class="btn-solido text-center" target="_blank" rel="noopener noreferrer">
        Pedir Presupuesto
      </a>
      <a href="#servicios" class="btn-contorno text-center">
        Ver nuestros trabajos
      </a>
    </div>
    
  </section>

  <!-- SECCIÓN DE SERVICIOS -->
  <section id="servicios" class="max-w-7xl mx-auto px-6 py-20">
    
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-carbon tracking-tight">Nuestro Catálogo</h2>
      <p class="mt-4 text-carbon-claro text-lg">Soluciones a medida para cada espacio de tu hogar.</p>
    </div>

    <!-- 2. Cuadrícula dinámica: iteramos sobre el array de servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {servicios.map((servicio) => (
        <a href={`/servicios/${servicio.id}`} class="tarjeta-servicio flex flex-col h-full overflow-hidden p-0 group">
          
          <!-- Contenedor de la imagen con relación de aspecto fija -->
          <div class="aspect-video w-full overflow-hidden bg-[#D4D4D0]">
            <img 
              src={servicio.imagen} 
              onerror="this.onerror=null;this.src='/img/image.png';this.style.objectFit='contain';this.style.padding='2rem';"
              alt={servicio.titulo} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          
          <!-- Contenido de texto -->
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-xl font-bold text-carbon mb-2">{servicio.titulo}</h3>
            <p class="text-carbon-claro flex-grow">{servicio.descripcion}</p>
            
            <span class="mt-6 inline-block font-semibold text-carbon group-hover:text-carbon-claro transition-colors">
              Ver detalles &rarr;
            </span>
          </div>

        </a>
      ))}
    </div>

  </section>
  <!-- SECCIÓN CTA FINAL -->
  <section class="max-w-7xl mx-auto px-6 py-20 mb-10">
    <div class="bg-carbon rounded-3xl p-10 md:p-16 text-center text-marfil flex flex-col items-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Tienes un proyecto en mente?</h2>
      <p class="text-marfil/80 text-lg max-w-2xl mb-8">
        Cuéntanos qué necesitas. Realizamos presupuestos aproximados y asesoramiento sin compromiso. ¡Estamos aquí para ayudarte a dar vida a tus ideas!</p>
      <a 
        href="https://wa.me/34616373306" 
        class="bg-marfil text-carbon font-semibold px-8 py-3 rounded-xl border-2 border-marfil transition-all duration-200 hover:bg-transparent hover:text-marfil" 
        target="_blank" 
        rel="noopener noreferrer"
      >
        Hablar por WhatsApp
      </a>
    </div>
  </section>

</Layout>