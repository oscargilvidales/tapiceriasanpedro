---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BannerCookies from '../components/BannerCookies.astro';
import '../global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	/** Datos estructurados (JSON-LD). Solo la portada lo usa. */
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	image = '/img/og-image.jpg',
	imageAlt = 'Logotipo de Tapicería San Pedro',
	noindex = false,
	jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://tapiceriasanpedro.com');
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Iconos (Google exige un favicon cuadrado de 48px o múltiplo) -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/icons/icon-96.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#F7F7F4" />

		<!-- Vista previa al compartir (WhatsApp, Facebook, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Tapicería San Pedro" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="bg-marfil">
		<Header />

		<!-- Aquí dentro caerá el contenido de index.astro -->
		<slot />
        <Footer />
		<BannerCookies />
		<script src="/i18n.js" is:inline></script>
	</body>
</html>
